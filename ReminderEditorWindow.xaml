<Window x:Class="NewDesk.ReminderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑提醒事项" SizeToContent="Height" Width="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="WindowTitleText" Text="编辑提醒事项" Style="{StaticResource Header1TextStyle}" Grid.Row="0" Margin="0,0,0,20"/>

        <!-- Inputs Container -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="提醒名称：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="TitleTextBox" Margin="0,0,0,16"/>

            <TextBlock Text="历法类型：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
            <ComboBox x:Name="TypeComboBox" SelectionChanged="TypeComboBox_SelectionChanged" Margin="0,0,0,16">
                <ComboBoxItem Content="公历 (阳历)"/>
                <ComboBoxItem Content="农历 (阴历)"/>
            </ComboBox>

            <TextBlock Text="提醒日期：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MonthComboBox" Grid.Column="0" SelectionChanged="MonthComboBox_SelectionChanged"/>
                <TextBlock Text="月" Grid.Column="1" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="8,0,16,0"/>
                <ComboBox x:Name="DayComboBox" Grid.Column="2"/>
                <TextBlock Text="日" Grid.Column="3" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <TextBlock Text="提前提醒天数：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="DaysInAdvanceTextBox" Text="0" Margin="0,0,0,16"/>
        </StackPanel>

        <!-- Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="90" IsCancel="True" Margin="0,0,12,0"/>
            <Button Content="保存提醒" Style="{StaticResource ModernButton}" Width="110" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
