<Window x:Class="NewDesk.ReminderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑提醒事项" SizeToContent="Height" Width="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="WindowTitleText" Text="编辑提醒事项" Style="{StaticResource Header1TextStyle}" Grid.Row="0" Margin="0,0,0,20"/>

        <!-- Inputs Container -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="提醒名称：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="TitleTextBox" Margin="0,0,0,14"/>

            <TextBlock Text="提醒类型：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
            <ComboBox x:Name="ScheduleTypeComboBox" SelectionChanged="ScheduleTypeComboBox_SelectionChanged" Margin="0,0,0,14">
                <ComboBoxItem Content="一次提醒 (OneTime)"/>
                <ComboBoxItem Content="每年公历 (Yearly)"/>
                <ComboBoxItem Content="每年农历 (LunarYearly)"/>
            </ComboBox>

            <!-- OneTime Panel -->
            <StackPanel x:Name="OneTimePanel" Visibility="Visible" Margin="0,0,0,14">
                <TextBlock Text="到期时间：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="DueDatePicker" Grid.Column="0" Margin="0,0,8,0"/>
                    <TextBox x:Name="DueTimeTextBox" Grid.Column="1" Text="09:00" ToolTip="格式 HH:mm"/>
                </Grid>
            </StackPanel>

            <!-- Yearly Panel -->
            <StackPanel x:Name="YearlyPanel" Visibility="Collapsed" Margin="0,0,0,14">
                <TextBlock Text="提醒日期与时间：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="MonthComboBox" Grid.Column="0" SelectionChanged="MonthComboBox_SelectionChanged"/>
                    <TextBlock Text="月" Grid.Column="1" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                    <ComboBox x:Name="DayComboBox" Grid.Column="2"/>
                    <TextBlock Text="日" Grid.Column="3" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                    <TextBox x:Name="YearlyTimeTextBox" Grid.Column="4" Text="09:00" ToolTip="格式 HH:mm"/>
                </Grid>
            </StackPanel>

            <TextBlock Text="提前提醒天数：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="DaysInAdvanceTextBox" Text="1" Margin="0,0,0,14"/>

            <TextBlock Text="备注：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="NotesTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"/>
        </StackPanel>

        <!-- Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="90" IsCancel="True" Margin="0,0,12,0"/>
            <Button Content="保存提醒" Style="{StaticResource ModernButton}" Width="110" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
