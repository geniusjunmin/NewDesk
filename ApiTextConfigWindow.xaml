<Window x:Class="NewDesk.ApiTextConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置API动态文本" Height="650" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A90E2"/>
        <SolidColorBrush x:Key="CardBackgroundColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#F5F5F5" CornerRadius="12" Margin="12">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="Auto"/> <!-- Preset -->
                    <RowDefinition Height="Auto"/> <!-- Param -->
                    <RowDefinition Height="Auto"/> <!-- URL -->
                    <RowDefinition Height="Auto"/> <!-- Regex -->
                    <RowDefinition Height="Auto"/> <!-- Prefix/Suffix -->
                    <RowDefinition Height="Auto"/> <!-- Formatting -->
                    <RowDefinition Height="Auto"/> <!-- Raw Data / JSON Helper -->
                    <RowDefinition Height="Auto"/> <!-- Preview -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="API动态文本配置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,20"/>

                <!-- 预设 -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <Label Content="预设方案:"/>
                    <ComboBox Name="PresetComboBox" SelectedIndex="0" SelectionChanged="PresetComboBox_SelectionChanged">
                        <ComboBoxItem Content="自定义"/>
                        <ComboBoxItem Content="天气 - 当前温度 (wttr.in)"/>
                        <ComboBoxItem Content="天气 - 天气描述 (wttr.in)"/>
                    </ComboBox>
                </StackPanel>

                <!-- 预设参数 -->
                <StackPanel Grid.Row="2" Name="PresetParamGrid" Visibility="Collapsed" Margin="0,0,0,12">
                    <Label Name="PresetParamLabel" Content="城市:"/>
                    <TextBox Name="PresetParamTextBox" ToolTip="例如: Beijing"/>
                </StackPanel>

                <!-- API URL -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <Label Content="API URL:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="ApiUrlTextBox" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="测试连接" Name="TestButton" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Click="TestButton_Click"/>
                    </Grid>
                </StackPanel>

                <!-- 正则表达式 -->
                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                    <Label Content="数据提取 (正则表达式):"/>
                    <TextBox Name="ApiRegexTextBox" TextChanged="ContentChanged_TriggerPreview"
                             ToolTip="使用正则表达式提取数据。例如 JSON 中提取: &quot;key&quot;: &quot;([^&quot;]+)&quot;"/>
                </StackPanel>

                <!-- 增加前后缀 -->
                <Grid Grid.Row="5" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="自定义前缀 (Prefix):"/>
                        <TextBox Name="ApiPrefixTextBox" TextChanged="ContentChanged_TriggerPreview" ToolTip="要在提取结果前显示的内容"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="自定义后缀 (Suffix):"/>
                        <TextBox Name="ApiSuffixTextBox" TextChanged="ContentChanged_TriggerPreview" ToolTip="要在提取结果后显示的内容"/>
                    </StackPanel>
                </Grid>

                <!-- 数据格式化 -->
                <StackPanel Grid.Row="6" Margin="0,0,0,12">
                    <Label Content="结果处理:"/>
                    <ComboBox Name="ApiFormattingComboBox" SelectedIndex="0" SelectionChanged="ApiFormattingComboBox_SelectionChanged">
                        <ComboBoxItem Content="直接显示提取结果"/>
                        <ComboBoxItem Content="流量单位转换 (B -> MB/GB)"/>
                    </ComboBox>
                </StackPanel>

                <!-- 原始数据 / JSON 辅助器 -->
                <Border Grid.Row="7" Background="{StaticResource CardBackgroundColor}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        <Label Content="API 响应数据:" Grid.Row="0"/>
                        <TextBlock Name="JsonHelperTip" Text="如果是 JSON，可点击下方字段尝试自动生成正则" Grid.Row="1" FontSize="11" Foreground="{StaticResource PrimaryColor}" Margin="0,-4,0,8" Visibility="Collapsed"/>
                        <TextBox Grid.Row="2" Name="RawResponseTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="12" BorderThickness="0"/>
                        <ScrollViewer Grid.Row="2" Name="JsonHelperScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Name="JsonHelperContainer"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 预览 -->
                <Border Grid.Row="8" Background="#E6F2FF" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="提取结果预览: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Name="ResultPreviewTextBlock" Text="等待测试..." FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 底部按钮 -->
                <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定保存" Name="OkButton" Width="120" Style="{StaticResource ModernButton}" Margin="0,0,12,0" IsDefault="True" Click="OkButton_Click"/>
                    <Button Content="取消" Name="CancelButton" Width="100" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
