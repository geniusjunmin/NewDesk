<Window x:Class="NewDesk.PasswordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加/编辑密码" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResize"
        Width="550"
        MinWidth="500"
        MaxWidth="700"
        Background="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A90E2"/>
        <SolidColorBrush x:Key="CardBackgroundColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalScrollBarVisibility="Disabled"
                                        HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalScrollBarVisibility="Disabled"
                                        HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Border Background="#F5F5F5" CornerRadius="12" Margin="8" x:Name="MainBorder">
        <Grid Margin="24" x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题 -->
            <TextBlock Grid.Row="0" 
                       Text="密码信息" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryColor}" 
                       Margin="0,0,0,20"/>
            
            <!-- 标题输入 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16" x:Name="TitlePanel">
                <Label Content="标题"/>
                <TextBox Name="TitleTextBox"/>
            </StackPanel>
            
            <!-- 用户名输入 -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16" x:Name="UsernamePanel">
                <Label Content="用户名"/>
                <TextBox Name="UsernameTextBox"/>
            </StackPanel>
            
            <!-- 密码输入 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16" x:Name="PasswordPanel">
                <Label Content="密码"/>
                <Grid MinHeight="40" x:Name="PasswordGrid">
                    <PasswordBox Name="PasswordBox" 
                               VerticalAlignment="Stretch"
                               VerticalContentAlignment="Center"/>
                    <TextBox Name="PasswordTextBox" 
                           Visibility="Collapsed"
                           VerticalAlignment="Stretch"
                           TextWrapping="Wrap" 
                           AcceptsReturn="True"
                           VerticalContentAlignment="Top"/>
                </Grid>
            </StackPanel>
            
            <!-- 密码选项 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,16" x:Name="OptionsPanel">
                <CheckBox Name="ShowPasswordCheckBox" 
                        Content="显示密码" 
                        VerticalAlignment="Center" 
                        Checked="ShowPasswordCheckBox_Changed" 
                        Unchecked="ShowPasswordCheckBox_Changed"/>
                <Button Content="复制" 
                      Width="80" 
                      Margin="16,0,0,0" 
                      Style="{StaticResource ModernButton}"
                      Click="CopyButton_Click"/>
            </StackPanel>
            
            <!-- 备注输入 -->
            <StackPanel Grid.Row="5" Margin="0,0,0,20" x:Name="NotesPanel">
                <Label Content="备注"/>
                <TextBox Name="NotesTextBox" 
                       TextWrapping="Wrap" 
                       AcceptsReturn="True" 
                       MinHeight="60"/>
            </StackPanel>
            
            <!-- 按钮区域 -->
            <StackPanel Grid.Row="7" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Right"
                       Margin="0,8,0,0"
                       x:Name="ButtonPanel">
                <Button Content="保存" 
                      Width="100" 
                      Margin="0,0,12,0" 
                      Style="{StaticResource ModernButton}"
                      IsDefault="True" 
                      Click="SaveButton_Click"/>
                <Button Content="取消" 
                      Width="100" 
                      Background="#E0E0E0" 
                      Foreground="{StaticResource TextColor}"
                      BorderThickness="0" 
                      Padding="20,10" 
                      Cursor="Hand"
                      IsCancel="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                  CornerRadius="6" 
                                  Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D0D0D0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
