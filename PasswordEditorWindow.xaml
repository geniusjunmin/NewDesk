<Window x:Class="NewDesk.PasswordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑密码条目" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Width="540" Height="580"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="WindowTitleText" Text="编辑密码条目" Style="{StaticResource Header1TextStyle}" Grid.Row="0" Margin="0,0,0,20"/>

        <!-- Inputs Container -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="名称 / 平台名称：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                <TextBox x:Name="TitleTextBox" Margin="0,0,0,16"/>

                <!-- Username -->
                <TextBlock Text="账号 / 用户名：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="密码：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="PasswordTextBox" Visibility="Collapsed" TextChanged="PasswordTextBox_TextChanged"/>
                </Grid>

                <!-- Password Toolbar & Strength Meter -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ShowPasswordCheckBox" Content="显示密码" Style="{StaticResource ToggleSwitchStyle}" Checked="ShowPasswordCheckBox_Changed" Unchecked="ShowPasswordCheckBox_Changed" Margin="0,0,16,0"/>
                        <TextBlock Text="强度：" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="StrengthProgressBar" Width="80" Height="6" Margin="4,0,8,0" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="StrengthText" Text="未输入" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="GeneratePasswordButton" Content="🎲 随机生成" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="0,0,6,0" Click="GeneratePasswordButton_Click"/>
                        <Button x:Name="CopyPasswordButton" Content="📋 复制" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Click="CopyButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Notes -->
                <TextBlock Text="备注说明：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                <TextBox x:Name="NotesTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalContentAlignment="Top" Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="90" IsCancel="True" Margin="0,0,12,0"/>
            <Button Content="保存密码" Style="{StaticResource ModernButton}" Width="110" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
