<Window x:Class="NewDesk.WallpaperEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面备注编辑器" Height="650" Width="1100"
        KeyDown="Window_KeyDown"
        Background="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A90E2"/>
        <SolidColorBrush x:Key="CardBackgroundColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E6F2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧面板 -->
        <Border Grid.Column="0" 
                Background="{StaticResource CardBackgroundColor}" 
                CornerRadius="8" 
                Margin="0,0,8,0"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="壁纸列表" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryColor}"
                           Margin="0,0,0,12"/>
                
                <ListBox Grid.Row="1" 
                         Name="WallpaperListBox" 
                         SelectionChanged="WallpaperListBox_SelectionChanged"
                         Margin="0,0,0,12"/>
                
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <Button Name="SaveAsButton" 
                            Content="另存为" 
                            Style="{StaticResource ModernButton}"
                            Margin="4" 
                            Click="SaveAsButton_Click"/>
                    <Button Name="UpdateButton" 
                            Content="更新" 
                            Style="{StaticResource ModernButton}"
                            Margin="4" 
                            Click="UpdateButton_Click"/>
                    <Button Name="DeleteButton" 
                            Content="删除" 
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="4" 
                            Click="DeleteButton_Click"/>
                </StackPanel>

                <!-- 壁纸轮换设置 -->
                <Border Grid.Row="3"
                        Background="{StaticResource CardBackgroundColor}" 
                        Margin="0,15,0,0" 
                        Padding="10" 
                        CornerRadius="8" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1">
                    <StackPanel>
                        <Label Content="壁纸轮换" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Padding="0,0,0,5"/>
                        <CheckBox Name="EnableRotationCheckBox" Content="启用自动轮换" Margin="0,5,0,5" Click="RotationSetting_Changed"/>
                        
                        <Label Content="轮换间隔:"/>
                        <ComboBox Name="RotationIntervalComboBox" Margin="0,2,0,5" SelectionChanged="RotationSetting_Changed">
                            <ComboBoxItem Content="1 分钟" Tag="1"/>
                            <ComboBoxItem Content="5 分钟" Tag="5"/>
                            <ComboBoxItem Content="15 分钟" Tag="15"/>
                            <ComboBoxItem Content="30 分钟" Tag="30"/>
                            <ComboBoxItem Content="1 小时" Tag="60"/>
                            <ComboBoxItem Content="3 小时" Tag="180"/>
                            <ComboBoxItem Content="12 小时" Tag="720"/>
                            <ComboBoxItem Content="1 天" Tag="1440"/>
                        </ComboBox>

                        <Label Content="轮换模式:"/>
                        <ComboBox Name="RotationModeComboBox" Margin="0,2,0,0" SelectionChanged="RotationSetting_Changed">
                            <ComboBoxItem Content="顺序轮换" Tag="Sequential"/>
                            <ComboBoxItem Content="随机轮换" Tag="Random"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧编辑区域 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Border Grid.Row="0" 
                    Background="{StaticResource CardBackgroundColor}" 
                    CornerRadius="8,8,0,0"
                    Padding="12"
                    Margin="0,0,0,8">
                <ToolBarTray>
                    <ToolBar>
                        <Button Content="📷 导入图片" 
                                Name="ImportImageButton" 
                                Style="{StaticResource ModernButton}"
                                Click="ImportImageButton_Click"/>
                        <Separator/>
                        <Label Content="文本类型:" VerticalAlignment="Center" Margin="8,0"/>
                        <ComboBox Name="TextTypeComboBox" 
                                  Width="120" 
                                  VerticalAlignment="Center" 
                                  SelectedIndex="0">
                            <ComboBoxItem Content="静态文本"/>
                            <ComboBoxItem Content="公历日期"/>
                            <ComboBoxItem Content="农历日期"/>
                            <ComboBoxItem Content="星期"/>
                            <ComboBoxItem Content="来自API"/>
                        </ComboBox>
                        <Button Content="添加" 
                                Name="AddTextButton" 
                                Style="{StaticResource ModernButton}"
                                Margin="8,0,0,0"
                                Click="AddTextButton_Click"/>
                        <Separator/>
                        <Label Content="字体:" VerticalAlignment="Center" Margin="8,0"/>
                        <ComboBox Name="FontFamilyComboBox" 
                                  Width="120" 
                                  SelectionChanged="FontFamilyComboBox_SelectionChanged"/>
                        <Label Content="字号:" VerticalAlignment="Center" Margin="8,0"/>
                        <Slider Name="FontSizeSlider" 
                                Width="100" 
                                Minimum="8" 
                                Maximum="120" 
                                Value="24" 
                                ValueChanged="FontSizeSlider_ValueChanged"/>
                        <TextBlock Name="FontSizeValueTextBlock" 
                                   Text="24" 
                                   VerticalAlignment="Center" 
                                   Margin="5,0"
                                   Foreground="{StaticResource TextColor}"/>
                        <Label Content="颜色:" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Name="FontColorButton" 
                                Click="FontColorButton_Click" 
                                Width="40" 
                                Height="28"
                                Margin="4,0">
                            <Button.Background>
                                <SolidColorBrush Color="White" x:Name="FontColorBrush"/>
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Separator/>
                        <CheckBox Name="SmartSnappingCheckBox" Content="智能吸附" IsChecked="True" VerticalAlignment="Center" Margin="8,0"/>
                        <Separator/>
                        <Label Content="对齐:" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Content="⬅" ToolTip="左对齐" Name="AlignLeftButton" Click="AlignLeftButton_Click" Width="30" Margin="2,0"/>
                        <Button Content="➡" ToolTip="右对齐" Name="AlignRightButton" Click="AlignRightButton_Click" Width="30" Margin="2,0"/>
                        <Button Content="⬆" ToolTip="顶对齐" Name="AlignTopButton" Click="AlignTopButton_Click" Width="30" Margin="2,0"/>
                        <Button Content="⬇" ToolTip="底对齐" Name="AlignBottomButton" Click="AlignBottomButton_Click" Width="30" Margin="2,0"/>
                        <Button Content="↔" ToolTip="水平居中" Name="AlignCenterHButton" Click="AlignCenterHButton_Click" Width="30" Margin="2,0"/>
                        <Button Content="↕" ToolTip="垂直居中" Name="AlignCenterVButton" Click="AlignCenterVButton_Click" Width="30" Margin="2,0"/>
                        <Separator/>
                        <Label Content="自动刷新:" VerticalAlignment="Center" Margin="8,0"/>
                        <ComboBox Name="RefreshIntervalComboBox" 
                                  Width="100" 
                                  SelectedIndex="0">
                            <ComboBoxItem Content="不自动刷新"/>
                            <ComboBoxItem Content="1 分钟"/>
                            <ComboBoxItem Content="5 分钟"/>
                            <ComboBoxItem Content="15 分钟"/>
                            <ComboBoxItem Content="30 分钟"/>
                            <ComboBoxItem Content="1 小时"/>
                        </ComboBox>
                        <Separator/>
                        <Button Content="✨ 生成并设为桌面" 
                                Name="SetWallpaperButton" 
                                Style="{StaticResource ModernButton}"
                                Margin="8,0,0,0"
                                Click="SetWallpaperButton_Click"/>
                    </ToolBar>
                </ToolBarTray>
            </Border>

            <!-- 画布区域 -->
            <Border Grid.Row="1" 
                    Background="{StaticResource CardBackgroundColor}" 
                    CornerRadius="0,0,8,8"
                    Padding="0"
                    ClipToBounds="True">
                <Viewbox Stretch="Uniform">
                    <Canvas Name="MainCanvas" Width="1920" Height="1080">
                        <Canvas.Background>
                            <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill"/>
                        </Canvas.Background>
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</Window>
