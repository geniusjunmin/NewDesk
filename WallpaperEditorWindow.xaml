<Window x:Class="NewDesk.WallpaperEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NewDesk 桌面编辑器" Height="780" Width="1280"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <!-- Modern Segmented Tab RadioButton Style -->
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceSecondaryBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Compact Segmented Alignment RadioButton Style -->
        <Style x:Key="SegmentedAlignRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/> <!-- Left Panel: Wallpapers & Rotation -->
            <ColumnDefinition Width="*"/>   <!-- Middle Panel: Canvas & Toolbar -->
            <ColumnDefinition Width="300"/> <!-- Right Panel: Properties / Layers -->
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT COLUMN: WALLPAPER LIBRARY ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Search -->
                    <RowDefinition Height="Auto"/> <!-- Import Button -->
                    <RowDefinition Height="*"/>    <!-- Wallpaper Cards List -->
                    <RowDefinition Height="Auto"/> <!-- Card Count & Divider -->
                    <RowDefinition Height="Auto"/> <!-- Rotation Settings -->
                    <RowDefinition Height="Auto"/> <!-- Apply to Desktop Primary Button -->
                </Grid.RowDefinitions>

                <!-- Header & Search -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="壁纸列表" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,8"/>
                    <TextBox x:Name="WallpaperSearchTextBox" Text="" TextChanged="WallpaperSearchTextBox_TextChanged"/>
                </StackPanel>

                <!-- Import Image Primary Button -->
                <Button x:Name="ImportImageButton" Grid.Row="1" Content="+ 导入图片" Style="{StaticResource ModernButton}" Margin="0,0,0,12" Click="ImportImageButton_Click"/>

                <!-- Wallpaper Cards List -->
                <ListBox x:Name="WallpaperListBox" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="WallpaperListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" Height="44" CornerRadius="6" Background="{DynamicResource SurfaceSecondaryBackground}" ClipToBounds="True" Margin="0,0,10,0">
                                        <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Name & Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}×{1}">
                                                    <Binding Path="DesignWidth"/>
                                                    <Binding Path="DesignHeight"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Actions Button (More Menu) -->
                                    <Button Grid.Column="2" Content="•••" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" VerticalAlignment="Center" Click="WallpaperMoreMenu_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer Count -->
                <StackPanel Grid.Row="3" Margin="0,8,0,12">
                    <TextBlock x:Name="WallpaperCountText" Text="共 0 张壁纸" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/>
                    <Separator Margin="0,8,0,0" Background="{DynamicResource BorderBrushColor}"/>
                </StackPanel>

                <!-- Rotation Settings Section -->
                <StackPanel Grid.Row="4" Margin="0,0,0,16">
                    <TextBlock Text="壁纸轮换设置" Style="{StaticResource Header2TextStyle}" FontSize="13" Margin="0,0,0,8"/>
                    
                    <CheckBox x:Name="EnableRotationCheckBox" Content="启用自动轮换" Style="{StaticResource ToggleSwitchStyle}" Click="RotationSettings_Changed" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="轮换间隔：" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="RotationIntervalComboBox" Grid.Column="1" SelectionChanged="RotationSettings_Changed">
                            <ComboBoxItem Content="5 分钟"/>
                            <ComboBoxItem Content="10 分钟"/>
                            <ComboBoxItem Content="15 分钟"/>
                            <ComboBoxItem Content="30 分钟"/>
                            <ComboBoxItem Content="1 小时"/>
                            <ComboBoxItem Content="2 小时"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="轮换模式：" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="RotationModeComboBox" Grid.Column="1" SelectionChanged="RotationSettings_Changed">
                            <ComboBoxItem Content="顺序轮换"/>
                            <ComboBoxItem Content="随机轮换"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <!-- Apply to Desktop Primary Button -->
                <Button x:Name="ApplyToDesktopButton" Grid.Row="5" Content="↻ 应用到桌面" Style="{StaticResource ModernButton}" Click="ApplyToDesktopButton_Click"/>
            </Grid>
        </Border>

        <!-- ==================== MIDDLE COLUMN: CANVAS & TOOLBAR ==================== -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Toolbar -->
                <RowDefinition Height="*"/>    <!-- Wallpaper Canvas Area -->
                <RowDefinition Height="Auto"/> <!-- Bottom Control Bar & Quick Insert -->
            </Grid.RowDefinitions>

            <!-- Top Toolbar Card -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Mode Tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="EditTabRadio" Content="A  编辑文字" IsChecked="True" GroupName="EditorTabGroup" Style="{StaticResource TabRadioButtonStyle}" Margin="0,0,8,0" Checked="TabRadio_Checked"/>
                        <RadioButton x:Name="LayerTabRadio" Content="☰  图层" GroupName="EditorTabGroup" Style="{StaticResource TabRadioButtonStyle}" Checked="TabRadio_Checked"/>
                    </StackPanel>

                    <!-- Right History & Save Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Content="↶ 撤销" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0" Click="UndoButton_Click"/>
                        <Button x:Name="RedoButton" Content="↷ 重做" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,12,0" Click="RedoButton_Click"/>

                        <ToggleButton x:Name="PreviewButton" Content="👁 预览" Padding="10,5" Margin="0,0,12,0" Click="PreviewButton_Click"/>
                        <Button x:Name="SaveButton" Content="保存壁纸" Style="{StaticResource ModernButton}" Padding="14,6" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Wallpaper Canvas Preview Area -->
            <Border Grid.Row="1" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,12">
                <Grid x:Name="CanvasContainerGrid" ClipToBounds="True" MouseLeftButtonDown="CanvasContainer_MouseLeftButtonDown">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Border x:Name="CanvasBorder" Background="{DynamicResource SurfaceBackground}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                            <Grid>
                                <!-- Wallpaper Background Image -->
                                <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>

                                <!-- Text Overlay Layer Canvas -->
                                <Canvas x:Name="MainCanvas" ClipToBounds="True">
                                    <!-- Selection Bounding Box Adorner -->
                                    <Border x:Name="SelectionBorder" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Grid Margin="-4">
                                            <Rectangle Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <Rectangle Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            <Rectangle Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </ScrollViewer>

                    <!-- Empty Wallpaper State -->
                    <Border x:Name="EmptyCanvasState" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🖼" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="还没有导入壁纸" Style="{StaticResource Header2TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="导入一张图片开始创建你的个性化桌面。" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <Button Content="+ 导入第一张壁纸" Style="{StaticResource ModernButton}" HorizontalAlignment="Center" Click="ImportImageButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Zoom Control Bar & Quick Insert Section -->
            <StackPanel Grid.Row="2">
                <!-- Zoom Controls Bar -->
                <Border Style="{StaticResource CardStyle}" Padding="10,6" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🖥 靠左" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" Click="AlignLeftCanvas_Click"/>
                            <Button Content="🗔 居中" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" Click="AlignCenterCanvas_Click"/>
                            <Button Content="🗖 靠右" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,12,0" Click="AlignRightCanvas_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="−" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" Click="ZoomOutButton_Click"/>
                            <Slider x:Name="ZoomSlider" Width="140" Minimum="25" Maximum="300" Value="100" VerticalAlignment="Center" Margin="8,0" ValueChanged="ZoomSlider_ValueChanged"/>
                            <Button Content="+" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" Click="ZoomInButton_Click"/>

                            <TextBlock x:Name="ZoomText" Text="100%" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold" Width="48" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                            <Button x:Name="ZoomFitButton" Content="+ 适配屏幕" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Click="ZoomFitButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quick Insert Toolbar -->
                <Border Style="{StaticResource CardStyle}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="快速插入：" Style="{StaticResource Header2TextStyle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="📅 公历日期" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddGregorianDateButton_Click"/>
                            <Button Content="📅 农历日期" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddLunarDateButton_Click"/>
                            <Button Content="📅 星期" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddDayOfWeekButton_Click"/>
                            <Button Content="🔗 API 数据" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddApiDataButton_Click"/>
                            <Button Content="Aa 自定义文本" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddCustomTextButton_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== RIGHT COLUMN: PROPERTIES / LAYERS PANEL ==================== -->
        <Border Grid.Column="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <!-- Properties Mode Panel -->
                <ScrollViewer x:Name="PropertiesScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertiesPanelContainer">
                        <!-- Panel Header & Active Tag -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="文字属性" Style="{StaticResource Header2TextStyle}"/>
                                <TextBlock x:Name="SelectedElementTag" Text="● 未选中任何元素" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="DeleteElementButton" Grid.Column="1" Content="🗑" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="14" Click="DeleteElementButton_Click"/>
                        </Grid>

                        <!-- Group 1: Typography -->
                        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="字体设置" Style="{StaticResource Header2TextStyle}" FontSize="13" Margin="0,0,0,8"/>

                                <TextBlock Text="字体：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FontFamilyComboBox" Margin="0,0,0,8" SelectionChanged="FontProperty_Changed"/>

                                <TextBlock Text="字号大小：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="300" Value="36" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="FontSizeSlider_ValueChanged"/>
                                    <TextBox x:Name="FontSizeTextBox" Grid.Column="1" Text="36" TextAlignment="Center" TextChanged="FontSizeTextBox_TextChanged"/>
                                </Grid>

                                <!-- Formatting Toggles & Color Picker Button -->
                                <UniformGrid Columns="4" Margin="0,4,0,0">
                                    <ToggleButton x:Name="BoldToggle" Content="B" FontWeight="Bold" Margin="2" Click="TextFormat_Click"/>
                                    <ToggleButton x:Name="ItalicToggle" Content="I" FontStyle="Italic" Margin="2" Click="TextFormat_Click"/>
                                    <ToggleButton x:Name="UnderlineToggle" Content="U" Margin="2" Click="TextFormat_Click"/>
                                    <Button x:Name="ColorPickerButton" Content="■ 颜色" Style="{StaticResource SecondaryButton}" Padding="4,2" Margin="2" Click="ColorPickerButton_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Position & Alignment -->
                        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="位置与布局" Style="{StaticResource Header2TextStyle}" FontSize="13" Margin="0,0,0,8"/>

                                <TextBlock Text="对齐方式：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="AlignLeftRadio" Content="左" IsChecked="True" Style="{StaticResource SegmentedAlignRadioButtonStyle}" Margin="2" Checked="Align_Checked"/>
                                    <RadioButton x:Name="AlignCenterRadio" Content="中" Style="{StaticResource SegmentedAlignRadioButtonStyle}" Margin="2" Checked="Align_Checked"/>
                                    <RadioButton x:Name="AlignRightRadio" Content="右" Style="{StaticResource SegmentedAlignRadioButtonStyle}" Margin="2" Checked="Align_Checked"/>
                                </UniformGrid>

                                <TextBlock Text="屏幕定位：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="靠左" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11" Margin="2" Click="QuickAlignLeft_Click"/>
                                    <Button Content="居中" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11" Margin="2" Click="QuickAlignCenterH_Click"/>
                                    <Button Content="靠右" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11" Margin="2" Click="QuickAlignRight_Click"/>
                                    <Button Content="靠上" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11" Margin="2" Click="QuickAlignTop_Click"/>
                                    <Button Content="垂直居中" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11" Margin="2" Click="QuickAlignCenterV_Click"/>
                                    <Button Content="靠下" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11" Margin="2" Click="QuickAlignBottom_Click"/>
                                </UniformGrid>

                                <TextBlock Text="位置偏移 (X / Y)：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="PositionXTextBox" Grid.Column="1" Text="50" TextChanged="Position_TextChanged"/>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Y:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="PositionYTextBox" Grid.Column="1" Text="80" TextChanged="Position_TextChanged"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: Text Effects -->
                        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="文字效果" Style="{StaticResource Header2TextStyle}" FontSize="13" Margin="0,0,0,8"/>

                                <CheckBox x:Name="ShadowCheckBox" Content="阴影" Style="{StaticResource ToggleSwitchStyle}" Click="EffectCheckBox_Click" Margin="0,0,0,6"/>
                                <CheckBox x:Name="StrokeCheckBox" Content="描边" Style="{StaticResource ToggleSwitchStyle}" Click="EffectCheckBox_Click" Margin="0,0,0,6"/>
                                <CheckBox x:Name="BackgroundCheckBox" Content="背景底色" Style="{StaticResource ToggleSwitchStyle}" Click="EffectCheckBox_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Group 4: Text Content -->
                        <Border Style="{StaticResource CardStyle}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="文字内容" Style="{StaticResource Header2TextStyle}" FontSize="13" Margin="0,0,0,8"/>
                                <TextBox x:Name="ContentTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" TextChanged="ContentTextBox_TextChanged"/>
                                <TextBlock Text="支持占位符: {公历日期} {农历日期} {星期} {API数据}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Layers Mode Panel (Switched by Top Toolbar ☰ 图层 Tab) -->
                <Grid x:Name="LayersPanelContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="☰ 元素图层" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>
                    <ListBox x:Name="LayersListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="LayersListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="▲" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="10" Margin="2,0" Click="MoveLayerUp_Click" Tag="{Binding}"/>
                                            <Button Content="▼" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="10" Margin="2,0" Click="MoveLayerDown_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
