<UserControl x:Class="NewDesk.Views.WallpapersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NewDesk.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Rotation Control Bar -->
            <RowDefinition Height="*"/>    <!-- Gallery Grid / Empty State -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🖼 桌面壁纸" Style="{StaticResource Header1TextStyle}"/>
                <TextBlock Text="管理壁纸图库，添加自定义桌面元素，并开启动态轮播" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="AddWallpaperButton" Grid.Column="1" Content="+ 添加壁纸" Style="{StaticResource ModernButton}" Width="130" Click="AddWallpaperButton_Click"/>
        </Grid>

        <!-- Rotation Settings Bar Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="EnableRotationCheckBox" Content="自动轮播" Style="{StaticResource ToggleSwitchStyle}" Click="RotationSettings_Changed" VerticalAlignment="Center"/>
                    
                    <TextBlock Text="间隔：" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <ComboBox x:Name="IntervalComboBox" Width="100" SelectionChanged="RotationSettings_Changed">
                        <ComboBoxItem Content="5 分钟"/>
                        <ComboBoxItem Content="10 分钟"/>
                        <ComboBoxItem Content="15 分钟"/>
                        <ComboBoxItem Content="30 分钟"/>
                        <ComboBoxItem Content="1 小时"/>
                        <ComboBoxItem Content="2 小时"/>
                    </ComboBox>

                    <TextBlock Text="模式：" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <RadioButton x:Name="SequentialRadio" Content="顺序" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True" Checked="RotationSettings_Changed"/>
                    <RadioButton x:Name="RandomRadio" Content="随机" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Checked="RotationSettings_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NextWallpaperButton" Content="⏭️ 切换下一张" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="NextWallpaperButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Gallery Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="WallpaperGalleryItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="8" Padding="12">
                                <StackPanel>
                                    <!-- Image Preview Thumbnail -->
                                    <Border Height="130" Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill"/>
                                            <TextBlock Text="🖼 无背景图片" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding BackgroundImagePath, Converter={StaticResource NullToVisibilityConverter}}"/>

                                            <Border x:Name="ActiveBadge" Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                <TextBlock Text="✓ 当前使用" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Title & Items Info -->
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Header2TextStyle}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TextElements.Count, StringFormat='{}桌面挂件：{0} 个'}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12"/>

                                    <!-- Action buttons -->
                                    <UniformGrid Columns="3">
                                        <Button Content="设为壁纸" Style="{StaticResource SecondaryButton}" Padding="4,4" FontSize="11" Margin="2" Click="ApplyWallpaper_Click" Tag="{Binding}"/>
                                        <Button Content="编辑" Style="{StaticResource SecondaryButton}" Padding="4,4" FontSize="11" Margin="2" Click="EditWallpaper_Click" Tag="{Binding}"/>
                                        <Button Content="删除" Style="{StaticResource DangerButton}" Padding="4,4" FontSize="11" Margin="2" Click="DeleteWallpaper_Click" Tag="{Binding}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border x:Name="EmptyStateBorder" Style="{StaticResource CardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Padding="32" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🖼" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="还没有桌面壁纸" Style="{StaticResource Header2TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="添加壁纸模板，可以在桌面上展示个性化信息。" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Content="添加第一张壁纸" Style="{StaticResource ModernButton}" HorizontalAlignment="Center" Click="AddWallpaperButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
