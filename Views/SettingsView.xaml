<UserControl x:Class="NewDesk.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="⚙ 系统设置" Style="{StaticResource Header1TextStyle}"/>
                    <TextBlock Text="管理 AI 模型服务、隐私授权、快捷键、主题外观、安全策略与数据备份" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Section 0: AI & LLM Service Configuration -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🤖 AI 与模型服务配置" Style="{StaticResource Header2TextStyle}"/>
                            <TextBlock Text="配置云端大模型 API（OpenAI, Claude, Gemini, xAI, MiniMax, DeepSeek）或本地模型（Ollama, LM Studio）" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ScanLocalModelsButton" Content="🔍 扫描本地模型 (Ollama / LM Studio)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ScanLocalModelsButton_Click"/>
                            <Button x:Name="AddAiProviderButton" Content="➕ 添加 AI 服务" Style="{StaticResource ModernButton}" Click="AddAiProviderButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="AiProvidersListView" MinHeight="160" Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Header2TextStyle}" Margin="0,0,8,0"/>
                                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="默认服务" FontSize="11" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BaseUrl}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding SelectedModel, StringFormat='当前模型: {0}'}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="✏️ 编辑" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0" Tag="{Binding}" Click="EditAiProviderButton_Click"/>
                                        <Button Grid.Column="2" Content="🗑 删除" Style="{StaticResource DangerButton}" Padding="10,4" Tag="{Binding}" Click="DeleteAiProviderButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Section 0.5: AI Privacy & Network Controls (Phase 16) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="🛡️ AI 隐私与网络安全控制" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>
                    <TextBlock Text="所有本地机密（主密码、密码文段、TOTP 密钥、API Key）永远不会发送给 AI。" Style="{StaticResource CaptionTextStyle}" Foreground="#38BDF8" Margin="0,0,0,12"/>

                    <TextBlock Text="网络传输模式：" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,6"/>
                    <StackPanel Margin="0,0,0,16">
                        <RadioButton x:Name="NetworkModeLocalRadio" Content="仅限本地模型模式 (绝对阻止任何云端 API 请求)" Checked="ImmediateSave_Click" Margin="0,2"/>
                        <RadioButton x:Name="NetworkModeAskRadio" Content="云端发送前询问 (每次发送至云端前弹出明细授权确认)" Checked="ImmediateSave_Click" Margin="0,2"/>
                        <RadioButton x:Name="NetworkModeAllowRadio" Content="允许云端 AI (信任配置的云端 AI 模型服务)" Checked="ImmediateSave_Click" Margin="0,2"/>
                    </StackPanel>

                    <TextBlock Text="允许向 AI 提交的数据上下文：" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="AllowReminderContextCheckBox" Grid.Row="0" Grid.Column="0" Content="提醒事项上下文" Click="ImmediateSave_Click" Margin="0,4"/>
                        <CheckBox x:Name="AllowWallpaperContextCheckBox" Grid.Row="0" Grid.Column="1" Content="当前壁纸上下文" Click="ImmediateSave_Click" Margin="0,4"/>

                        <CheckBox x:Name="AllowDynamicDataContextCheckBox" Grid.Row="1" Grid.Column="0" Content="动态数据源上下文" Click="ImmediateSave_Click" Margin="0,4"/>
                        <CheckBox x:Name="AllowPasswordMetadataCheckBox" Grid.Row="1" Grid.Column="1" Content="密码库站点元数据 (无密码)" Click="ImmediateSave_Click" Margin="0,4"/>

                        <CheckBox x:Name="AllowLogsCheckBox" Grid.Row="2" Grid.Column="0" Content="系统运行日志" Click="ImmediateSave_Click" Margin="0,4"/>
                        <CheckBox x:Name="AllowClipboardCheckBox" Grid.Row="2" Grid.Column="1" Content="剪贴板文本" Click="ImmediateSave_Click" Margin="0,4"/>
                        <CheckBox x:Name="AllowSystemInfoCheckBox" Grid.Row="3" Grid.Column="0" Content="系统设备信息" Click="ImmediateSave_Click" Margin="0,4"/>
                    </Grid>

                    <CheckBox x:Name="AllowBackgroundCloudCheckBox" Content="允许后台 Cloud AI (供定时器、AI 动态数据静默更新使用)" Style="{StaticResource ToggleSwitchStyle}" Click="ImmediateSave_Click"/>
                </StackPanel>
            </Border>

            <!-- Section 1: General Settings -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="常规设置" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>

                    <CheckBox x:Name="AutoStartCheckBox" Content="Windows 开机自动启动 NewDesk" Style="{StaticResource ToggleSwitchStyle}" Click="ImmediateSave_Click" Margin="0,0,0,12"/>

                    <TextBlock Text="启动行为：" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="StartupBehaviorNormalRadio" Content="打开主窗口" IsChecked="True" Checked="ImmediateSave_Click" Margin="0,0,16,0"/>
                        <RadioButton x:Name="StartupBehaviorTrayRadio" Content="最小化到系统托盘" Checked="ImmediateSave_Click"/>
                    </StackPanel>

                    <TextBlock Text="点击窗口关闭按钮时：" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="CloseBehaviorTrayRadio" Content="最小化到系统托盘" IsChecked="True" Checked="ImmediateSave_Click" Margin="0,0,16,0"/>
                        <RadioButton x:Name="CloseBehaviorExitRadio" Content="退出 NewDesk" Checked="ImmediateSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 2: Hotkeys (Phase 17) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="⌨️ 全局快捷键配置" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="显示/隐藏主窗口" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="TxtMainWindowHotkey" Grid.Column="1" Text="Ctrl + Alt + D" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Content="修改" Tag="MainWindow" Style="{StaticResource SecondaryButton}" Padding="12,4" Click="RebindHotkey_Click"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AI 快捷提问窗口" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="TxtAiQuickHotkey" Grid.Column="1" Text="Ctrl + Shift + Space" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Content="修改" Tag="AiQuick" Style="{StaticResource SecondaryButton}" Padding="12,4" Click="RebindHotkey_Click"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Command Palette 命令面板" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="TxtCommandPaletteHotkey" Grid.Column="1" Text="Ctrl + K" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Content="修改" Tag="CommandPalette" Style="{StaticResource SecondaryButton}" Padding="12,4" Click="RebindHotkey_Click"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="剪贴板 AI 悬浮窗" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="TxtClipboardAiHotkey" Grid.Column="1" Text="Ctrl + Shift + A" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Content="修改" Tag="ClipboardAi" Style="{StaticResource SecondaryButton}" Padding="12,4" Click="RebindHotkey_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: Notifications -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="通知与提醒" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>

                    <CheckBox x:Name="EnableNotificationsCheckBox" Content="开启日程提醒通知" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ImmediateSave_Click" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="提醒检查频率（旧设置，仅兼容）：" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="新调度器固定每分钟检查，以保证定时提醒不会错过。" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="ReminderFrequencyComboBox" Grid.Column="1" Width="140" IsEnabled="False" SelectionChanged="ReminderFrequency_SelectionChanged">
                            <ComboBoxItem Content="每天一次"/>
                            <ComboBoxItem Content="每小时"/>
                            <ComboBoxItem Content="每半小时"/>
                            <ComboBoxItem Content="每分钟"/>
                        </ComboBox>
                    </Grid>

                    <Button x:Name="SendTestNotificationButton" Content="🔔 发送测试通知" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="SendTestNotificationButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Section 4: Security & Password Vault -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="安全与密码库" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="主密码管理" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="用于加密和访问密码库的核心主密码" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="ChangeMasterPasswordButton" Grid.Column="1" Content="🔑 修改主密码" Style="{StaticResource SecondaryButton}" Click="ChangeMasterPasswordButton_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="无操作自动锁定密码库：" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="一段时间无操作后清空内存中的主密码" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="AutoLockComboBox" Grid.Column="1" Width="140" SelectionChanged="ImmediateSave_Click">
                            <ComboBoxItem Content="从不"/>
                            <ComboBoxItem Content="5 分钟"/>
                            <ComboBoxItem Content="15 分钟"/>
                            <ComboBoxItem Content="30 分钟"/>
                            <ComboBoxItem Content="60 分钟"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="LockOnWindowsLockCheckBox" Content="Windows 锁屏后自动锁定密码库" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ImmediateSave_Click"/>
                </StackPanel>
            </Border>

            <!-- Section 5: Features Toggle -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="功能模块展示" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="EnablePasswordsCheckBox" Content="密码管理" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ImmediateSave_Click" Margin="0,0,0,8"/>
                    <CheckBox x:Name="EnableRemindersCheckBox" Content="提醒事项" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ImmediateSave_Click" Margin="0,0,0,8"/>
                    <CheckBox x:Name="EnableWallpaperCheckBox" Content="桌面壁纸" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ImmediateSave_Click" Margin="0,0,0,8"/>
                    <CheckBox x:Name="EnableDynamicInfoCheckBox" Content="API 动态信息" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Click="ImmediateSave_Click"/>
                </StackPanel>
            </Border>

            <!-- Section 6: Appearance & Theme -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="外观主题" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" IsChecked="True" Checked="Theme_SelectionChanged" Margin="0,0,20,0"/>
                        <RadioButton x:Name="ThemeLightRadio" Content="浅色主题" Checked="Theme_SelectionChanged" Margin="0,0,20,0"/>
                        <RadioButton x:Name="ThemeDarkRadio" Content="深色主题" Checked="Theme_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 7: Data & Backup -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="数据与便携备份" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>

                    <TextBlock x:Name="DataPathText" Text="数据目录：%AppData%\NewDesk" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"/>
                    <TextBlock Text="AI 对话历史使用 Windows 用户加密，不包含在便携备份中。" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="OpenDataFolderButton" Content="📁 打开数据目录" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OpenDataFolderButton_Click"/>
                        <Button x:Name="ExportBackupButton" Content="📥 导出便携备份 (.ndbackup)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="ExportBackupButton_Click"/>
                        <Button x:Name="ImportBackupButton" Content="📤 恢复便携备份 (.ndbackup)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="ImportBackupButton_Click"/>
                    </WrapPanel>

                    <Border Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ 重置 NewDesk" Style="{StaticResource Header2TextStyle}" Foreground="{DynamicResource DangerBrush}"/>
                                <TextBlock Text="恢复所有初始设置，删除本地保存的所有数据" Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                            <Button x:Name="ResetAppButton" Grid.Column="1" Content="重置应用" Style="{StaticResource DangerButton}" Click="ResetAppButton_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Section 8: Re-run Setup Wizard -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🚀 重新运行设置向导" Style="{StaticResource Header2TextStyle}"/>
                        <TextBlock Text="再次打开 5 步初始化引导界面调整所有配置" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                    <Button x:Name="RerunWizardButton" Grid.Column="1" Content="运行设置向导" Style="{StaticResource SecondaryButton}" Click="RerunWizardButton_Click"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
