<Window x:Class="NewDesk.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NewDesk Command Palette" Height="360" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource WindowBackground}" CornerRadius="16" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="Black" Opacity="0.4" ShadowDepth="8"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search Bar -->
                <RowDefinition Height="*"/>    <!-- Commands List -->
                <RowDefinition Height="Auto"/> <!-- Keybind Legend -->
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchTextBox" Grid.Column="1" FontSize="16" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown" Tag="输入命令名称 (例如: 密码, 壁纸, AI, 锁屏)..."/>
            </Grid>

            <!-- Commands List -->
            <ListBox x:Name="CommandsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="CommandsListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding ShortcutKey}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer -->
            <TextBlock Grid.Row="2" Text="↑ ↓ 选择 | Enter 确认执行 | Esc 退出 (Ctrl + K 呼出)" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>
