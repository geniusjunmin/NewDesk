<Window x:Class="NewDesk.Views.AiQuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NewDesk AI Quick Search" Height="220" Width="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Background="{DynamicResource WindowBackground}" CornerRadius="16" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="Black" Opacity="0.4" ShadowDepth="8"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search Bar -->
                <RowDefinition Height="*"/>    <!-- Streaming Response Panel -->
                <RowDefinition Height="Auto"/> <!-- Actions Footer -->
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="QuickInputTextBox" Grid.Column="1" FontSize="16" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" PreviewKeyDown="QuickInputTextBox_PreviewKeyDown" Tag="提问 AI 助手... (Enter 快捷搜索，Esc 退出)"/>
                <Button x:Name="SendQuickButton" Grid.Column="2" Content="发送 ➔" Style="{StaticResource ModernButton}" Padding="12,4" Click="SendQuickButton_Click"/>
            </Grid>

            <!-- Result Panel -->
            <ScrollViewer x:Name="ResultScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <TextBlock x:Name="ResultTextBlock" Text="输入问题按下 Enter，获取 AI 极速回答..." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- Actions Footer -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CopyButton" Content="📋 复制结果" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,8,0" Click="CopyButton_Click"/>
                    <ToggleButton x:Name="PinToggle" Content="📌 固定窗口" Style="{StaticResource SecondaryButton}" Padding="8,2"/>
                </StackPanel>

                <TextBlock Text="Ctrl + Shift + Space 唤醒 | Esc 退出" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
