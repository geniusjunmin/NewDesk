<UserControl x:Class="NewDesk.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Page Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🏠 首页概览" Style="{StaticResource Header1TextStyle}"/>
                    <TextBlock Text="查看当前 NewDesk 系统的各项状态与快捷操作" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Quick Action Bar -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="快捷操作" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="AddPasswordQuickButton" Content="+ 添加密码" Style="{StaticResource ModernButton}" Margin="0,0,12,8" Click="AddPasswordQuickButton_Click"/>
                        <Button x:Name="AddReminderQuickButton" Content="+ 添加提醒" Style="{StaticResource ModernButton}" Margin="0,0,12,8" Click="AddReminderQuickButton_Click"/>
                        <Button x:Name="ChangeWallpaperQuickButton" Content="🖼 更换壁纸" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8" Click="ChangeWallpaperQuickButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Overview Grid Cards -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- Card 1: Password Vault -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="密码库" Style="{StaticResource Header2TextStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="PasswordVaultStatusText" Text="已解锁 🔓" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/>
                        </Grid>
                        <TextBlock x:Name="PasswordCountText" Text="加载中..." Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Margin="0,4"/>
                        <TextBlock x:Name="PasswordRecentText" Text="最近更新：暂无" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Reminders -->
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="提醒事项" Style="{StaticResource Header2TextStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ReminderCountText" Text="加载中..." Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Margin="0,4"/>
                        <TextBlock x:Name="ReminderNextText" Text="下一个提醒：暂无" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Wallpaper Status -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="桌面壁纸" Style="{StaticResource Header2TextStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="WallpaperCurrentText" Text="当前壁纸：默认" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WallpaperRotationStatusText" Text="自动轮播：未开启" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: System Status -->
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="系统状态" Style="{StaticResource Header2TextStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="SysHotkeyStatusText" Text="✓ 全局快捷键：Ctrl + Alt + D" Style="{StaticResource CaptionTextStyle}" Margin="0,2"/>
                        <TextBlock x:Name="SysStartupStatusText" Text="✓ 开机自启：已开启" Style="{StaticResource CaptionTextStyle}" Margin="0,2"/>
                        <TextBlock x:Name="SysLockStatusText" Text="✓ 密码库：已解锁" Style="{StaticResource CaptionTextStyle}" Margin="0,2"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Friendly Empty State Card when system has no data -->
            <Border x:Name="EmptyStateCard" Style="{StaticResource CardStyle}" Visibility="Collapsed" Background="{DynamicResource SurfaceSecondaryBackground}" Padding="32">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔑" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="你的密码库还是空的" Style="{StaticResource Header2TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="把常用账号与重要提醒保存在这里，以后可以随时一键搜索和访问。" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="添加第一个密码" Style="{StaticResource ModernButton}" HorizontalAlignment="Center" Click="AddPasswordQuickButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
