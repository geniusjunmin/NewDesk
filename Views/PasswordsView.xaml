<UserControl x:Class="NewDesk.Views.PasswordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="24">
        <!-- Locked State Panel -->
        <Border x:Name="LockedPanel" Style="{StaticResource CardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Padding="32" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔒" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="密码库已锁定" Style="{StaticResource Header1TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="请输入主密码以解锁并访问您的账号及密码数据。" Style="{StaticResource SubHeaderTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

                <PasswordBox x:Name="UnlockPasswordBox" Margin="0,0,0,16" KeyDown="UnlockPasswordBox_KeyDown"/>
                <Button x:Name="UnlockButton" Content="解锁密码库" Style="{StaticResource ModernButton}" HorizontalAlignment="Stretch" Click="UnlockButton_Click"/>
                <TextBlock x:Name="UnlockErrorText" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Unlocked Vault View -->
        <Grid x:Name="UnlockedVaultGrid" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Page Header & Top Bar -->
                <RowDefinition Height="Auto"/> <!-- Search & Actions Bar -->
                <RowDefinition Height="*"/>    <!-- Password List / Empty State -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔑 密码管理" Style="{StaticResource Header1TextStyle}"/>
                    <TextBlock Text="安全加密保存并快速检索访问您的账号密码" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 导入旧数据" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ImportLegacyButton_Click"/>
                    <Button Content="🔒 锁定" Style="{StaticResource SecondaryButton}" Click="LockVaultButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Search & Primary Action Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox" Grid.Column="0" Margin="0,0,12,0" Padding="12,8" TextChanged="SearchTextBox_TextChanged"/>

                <Button x:Name="AddPasswordButton" Grid.Column="1" Content="+ 添加密码" Style="{StaticResource ModernButton}" Width="130" Click="AddPasswordButton_Click"/>
            </Grid>

            <!-- List View -->
            <Grid Grid.Row="2">
                <ListView x:Name="PasswordListView" 
                          Background="{DynamicResource SurfaceBackground}"
                          BorderBrush="{DynamicResource BorderBrushColor}"
                          BorderThickness="1"
                          MouseDoubleClick="PasswordListView_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <!-- Title Column -->
                            <GridViewColumn Header="名称 / 平台" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔑" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Username Column -->
                            <GridViewColumn Header="账号 / 用户名" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Username}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Notes Column -->
                            <GridViewColumn Header="备注" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Actions Column -->
                            <GridViewColumn Header="快速操作" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="复制账号" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="0,0,4,0" Click="CopyUsernameItem_Click" Tag="{Binding}"/>
                                            <Button Content="复制密码" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="0,0,4,0" Click="CopyPasswordItem_Click" Tag="{Binding}"/>
                                            <Button Content="编辑" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="0,0,4,0" Click="EditItem_Click" Tag="{Binding}"/>
                                            <Button Content="删除" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="12" Click="DeleteItem_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty State -->
                <Border x:Name="EmptyStateBorder" Style="{StaticResource CardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Padding="24" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔑" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock x:Name="EmptyStateTitle" Text="还没有保存任何密码" Style="{StaticResource Header2TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="保存常用账号，以后可快速检索与复制。" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Content="添加第一个密码" Style="{StaticResource ModernButton}" HorizontalAlignment="Center" Click="AddPasswordButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
