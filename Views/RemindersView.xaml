<UserControl x:Class="NewDesk.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!-- DataTemplate for Reminder Item -->
    <UserControl.Resources>
        <DataTemplate x:Key="ReminderItemTemplate">
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📅" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Header2TextStyle}"/>
                            <Border Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReminderType}" Style="{StaticResource CaptionTextStyle}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}每年 {0} 月 {1} 日">
                                    <Binding Path="Month"/>
                                    <Binding Path="Day"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="{Binding NextReminderDate, StringFormat='{}目标日期：{0:yyyy-MM-dd}'}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DaysInAdvance, StringFormat='{}提前 {0} 天通知'}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="编辑" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="EditReminder_Click" Tag="{Binding}"/>
                        <Button Content="删除" Style="{StaticResource DangerButton}" Padding="10,5" FontSize="12" Click="DeleteReminder_Click" Tag="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Reminders List -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🔔 提醒事项" Style="{StaticResource Header1TextStyle}"/>
                <TextBlock Text="管理重要日期、倒计时与生日提醒，自动推送到 Windows 通知栏" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="AddReminderButton" Grid.Column="1" Content="+ 新建提醒" Style="{StaticResource ModernButton}" Width="130" Click="AddReminderButton_Click"/>
        </Grid>

        <!-- Grouped Reminders Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Group 1: Today Reminders -->
                <Border x:Name="TodayHeaderBorder" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔥 今天到期的提醒" Style="{StaticResource Header2TextStyle}" Foreground="{DynamicResource DangerBrush}"/>
                        <Border x:Name="TodayBadgeBorder" Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TodayBadgeText" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="TodayItemsControl" ItemTemplate="{StaticResource ReminderItemTemplate}" Margin="0,0,0,16"/>

                <!-- Group 2: Upcoming Reminders (30 Days) -->
                <Border x:Name="UpcomingHeaderBorder" Margin="0,8,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳ 近期（30天内）提醒" Style="{StaticResource Header2TextStyle}" Foreground="{DynamicResource WarningBrush}"/>
                        <Border x:Name="UpcomingBadgeBorder" Background="{DynamicResource WarningBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UpcomingBadgeText" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="UpcomingItemsControl" ItemTemplate="{StaticResource ReminderItemTemplate}" Margin="0,0,0,16"/>

                <!-- Group 3: Later Reminders -->
                <Border x:Name="LaterHeaderBorder" Margin="0,8,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📅 以后提醒" Style="{StaticResource Header2TextStyle}"/>
                        <Border x:Name="LaterBadgeBorder" Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LaterBadgeText" Text="0" Style="{StaticResource CaptionTextStyle}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="LaterItemsControl" ItemTemplate="{StaticResource ReminderItemTemplate}" Margin="0,0,0,16"/>

                <!-- Empty State -->
                <Border x:Name="EmptyStateBorder" Style="{StaticResource CardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Padding="32" Margin="0,40,0,0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="还没有设置提醒" Style="{StaticResource Header2TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="添加生日、纪念日或重要日程，定时推送到 Windows 通知。" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Content="创建第一个提醒" Style="{StaticResource ModernButton}" HorizontalAlignment="Center" Click="AddReminderButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
