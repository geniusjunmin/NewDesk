<UserControl x:Class="NewDesk.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Primary CTA -->
            <RowDefinition Height="*"/>    <!-- Grouped Content / Empty State -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🔔 提醒事项" Style="{StaticResource Header1TextStyle}"/>
                <TextBlock Text="记录生日、纪念日与重要事项，并在合适的时间通知您" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="AddReminderButton" Grid.Column="1" Content="+ 新建提醒" Style="{StaticResource ModernButton}" Width="130" Click="AddReminderButton_Click"/>
        </Grid>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Group 1: Today -->
                <StackPanel x:Name="TodayGroupPanel" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📌 今天" Style="{StaticResource Header2TextStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TodayBadgeText" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="TodayItemsControl"/>
                </StackPanel>

                <!-- Group 2: Upcoming -->
                <StackPanel x:Name="UpcomingGroupPanel" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🗓 即将到来 (30天内)" Style="{StaticResource Header2TextStyle}"/>
                        <Border Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UpcomingBadgeText" Text="0" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="UpcomingItemsControl"/>
                </StackPanel>

                <!-- Group 3: Later -->
                <StackPanel x:Name="LaterGroupPanel" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📅 以后" Style="{StaticResource Header2TextStyle}"/>
                        <Border Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LaterBadgeText" Text="0" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="LaterItemsControl"/>
                </StackPanel>

                <!-- Empty State -->
                <Border x:Name="EmptyStateBorder" Style="{StaticResource CardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Padding="32" Margin="0,40,0,0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="还没有提醒事项" Style="{StaticResource Header2TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="添加重要的生日、纪念日，避免遗忘。" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Content="创建第一个提醒" Style="{StaticResource ModernButton}" HorizontalAlignment="Center" Click="AddReminderButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- DataTemplate for Reminder Item -->
    <UserControl.Resources>
        <DataTemplate x:Key="ReminderItemTemplate">
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📅" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Header2TextStyle}"/>
                            <Border Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReminderType}" Style="{StaticResource CaptionTextStyle}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Month, StringFormat='{}每年 {0} 月 {1} 日', ConverterParameter={Binding Day}}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="{Binding NextReminderDate, StringFormat='{}目标日期：{0:yyyy-MM-dd}'}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DaysInAdvance, StringFormat='{}提前 {0} 天通知'}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="编辑" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="EditReminder_Click" Tag="{Binding}"/>
                        <Button Content="删除" Style="{StaticResource DangerButton}" Padding="10,5" FontSize="12" Click="DeleteReminder_Click" Tag="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
</UserControl>
