<UserControl x:Class="NewDesk.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="? 帮助与关于" Style="{StaticResource Header1TextStyle}"/>
                    <TextBlock Text="关于 NewDesk、快捷键指南与开发者反馈" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Card 1: App Info -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚡" FontSize="36" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NewDesk 桌面助手" Style="{StaticResource Header1TextStyle}"/>
                            <TextBlock x:Name="VersionText" Text="版本 v1.0.0 · 基于 .NET 9 与 WPF" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="NewDesk 是一款轻量、现代的 Windows 桌面效率助手，集成了安全密码管理、重要日期提醒、动态桌面壁纸轮播与 API 信息挂件等核心功能。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <WrapPanel>
                        <Button x:Name="OpenDataFolderButton" Content="📁 打开数据目录" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OpenDataFolderButton_Click"/>
                        <Button x:Name="GitHubButton" Content="🌐 访问 GitHub 仓库" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="GitHubButton_Click"/>
                        <Button x:Name="FeedbackButton" Content="💬 提交问题反馈" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="FeedbackButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Hotkeys Cheatsheet -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="快捷键指南" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl + Alt + D" FontWeight="Bold" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="随时显示或隐藏 NewDesk 主界面" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl + F" FontWeight="Bold" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="快速聚焦并全选搜索框" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl + N" FontWeight="Bold" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="快速新建当前页面对应的项目 (密码/提醒/壁纸)" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Esc" FontWeight="Bold" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="快速关闭弹窗与对话框" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
