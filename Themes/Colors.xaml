<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent / Brand Colors -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <Color x:Key="PrimaryPressedColor">#1E40AF</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>

    <!-- Dark Theme Default Brushes -->
    <SolidColorBrush x:Key="WindowBackground" Color="#111827"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="#1F2937"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBackground" Color="#374151"/>
    <SolidColorBrush x:Key="SurfaceHoverBackground" Color="#4B5563"/>
    
    <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
    
    <SolidColorBrush x:Key="BorderBrushColor" Color="#374151"/>
    <SolidColorBrush x:Key="InputBackground" Color="#111827"/>
    
    <SolidColorBrush x:Key="SidebarBackground" Color="#111827"/>
    <SolidColorBrush x:Key="SidebarItemHover" Color="#1F2937"/>
    <SolidColorBrush x:Key="SidebarItemSelected" Color="#2563EB"/>
    <SolidColorBrush x:Key="SidebarTextSelected" Color="#FFFFFF"/>

</ResourceDictionary>
