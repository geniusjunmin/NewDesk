<Window x:Class="NewDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="NewDesk" Height="700" Width="1000" 
        WindowState="Minimized" ShowInTaskbar="False"
        Background="#F5F5F5">
    <Window.Resources>
        <!-- 颜色资源 -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A90E2"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#357ABD"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#6BA3E8"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="CardBackgroundColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#666666"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#52C41A"/>
        <SolidColorBrush x:Key="DangerColor" Color="#FF4D4F"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FAAD14"/>
        
        <!-- 按钮样式 -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>
        
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
        </Style>
        
        <!-- TextBox 样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- PasswordBox 样式 -->
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- ListView 样式 -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        
        <!-- GridViewColumnHeader 样式 -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="8,10"
                                Margin="{TemplateBinding Margin}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" 
                                                 Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E6F2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- TabControl 样式 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Label 样式 -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- CheckBox 样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- ComboBox 样式 -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="False" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="3,3,23,3" VerticalAlignment="Stretch" HorizontalAlignment="Left"/>
                                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,3,23,3" Focusable="True" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder" Background="{StaticResource CardBackgroundColor}" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" CornerRadius="6" Margin="0,4,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="4" Opacity="0.2"/>
                                            </Border.Effect>
                                        </Border>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Card 样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon" ToolTipText="NewDesk" TrayLeftMouseUp="ShowWindow_Click">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="{StaticResource CardBackgroundColor}">
                    <MenuItem Header="显示窗口" Click="ShowWindow_Click" Foreground="{StaticResource TextColor}"/>
                    <MenuItem Header="退出" Click="Exit_Click" Foreground="{StaticResource TextColor}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        
        <Border Background="{StaticResource BackgroundColor}" CornerRadius="12" Margin="8">
            <Grid>
                <!-- 标题栏 -->
                <Border Background="{StaticResource CardBackgroundColor}" Height="60" CornerRadius="12,12,0,0">
                    <Grid>
                        <TextBlock Text="NewDesk" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryColor}" 
                                   VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </Grid>
                </Border>
                
                <!-- 内容区域 -->
                <TabControl Margin="0,60,0,0" Background="Transparent">
                    <TabItem x:Name="PasswordTab" Header="密码管理">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 搜索框 -->
                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <TextBox x:Name="SearchTextBox" 
                                             TextChanged="SearchTextBox_TextChanged"
                                             GotFocus="SearchTextBox_GotFocus"
                                             LostFocus="SearchTextBox_LostFocus"/>
                                    <TextBlock x:Name="SearchPlaceholder"
                                               Text="搜索密码..."
                                               IsHitTestVisible="False"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               VerticalAlignment="Center"
                                               Margin="15,0,0,0"
                                               Visibility="Visible"/>
                                </Grid>
                            </Border>
                            
                            <!-- 密码列表 -->
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <ListView x:Name="PasswordListView" BorderThickness="0" MouseDoubleClick="PasswordListView_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="标题" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Padding="8,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="用户名" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Username}" VerticalAlignment="Center" Padding="8,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="备注" Width="300">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Notes}" VerticalAlignment="Center" Padding="8,0" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                            
                            <!-- 操作按钮 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ImportLegacyButton" Content="导入旧版" Style="{StaticResource SecondaryButton}" Click="ImportLegacyButton_Click"/>
                                <Button x:Name="AddButton" Content="➕ 添加" Style="{StaticResource ModernButton}" Click="AddButton_Click"/>
                                <Button x:Name="EditButton" Content="✏️ 编辑" Style="{StaticResource ModernButton}" Click="EditButton_Click"/>
                                <Button x:Name="DeleteButton" Content="🗑️ 删除" Style="{StaticResource DangerButton}" Click="DeleteButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    
                    <TabItem Header="提醒管理">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 提醒列表 -->
                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <ListView x:Name="ReminderListView" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="标题" Width="300">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Padding="8,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="日期" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock VerticalAlignment="Center" Padding="8,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}月{1}日 ({2})">
                                                                    <Binding Path="Month"/>
                                                                    <Binding Path="Day"/>
                                                                    <Binding Path="ReminderType"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                            
                            <!-- 操作按钮 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="TestReminderButton" Content="🔔 测试提醒" Style="{StaticResource SecondaryButton}" Click="TestReminderButton_Click"/>
                                <Button x:Name="AddReminderButton" Content="➕ 添加" Style="{StaticResource ModernButton}" Click="AddReminderButton_Click"/>
                                <Button x:Name="EditReminderButton" Content="✏️ 编辑" Style="{StaticResource ModernButton}" Click="EditReminderButton_Click"/>
                                <Button x:Name="DeleteReminderButton" Content="🗑️ 删除" Style="{StaticResource DangerButton}" Click="DeleteReminderButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    
                    <TabItem Header="设置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
                            <StackPanel>
                                <!-- 桌面备注编辑器 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Button x:Name="OpenWallpaperEditorButton" 
                                            Content="🎨 打开桌面备注编辑器" 
                                            Style="{StaticResource ModernButton}"
                                            HorizontalAlignment="Stretch"
                                            Click="OpenWallpaperEditorButton_Click"/>
                                </Border>
                                
                                <!-- 开机自启动 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <CheckBox x:Name="StartupCheckBox" 
                                              Content="开机自启动" 
                                              Checked="StartupCheckBox_Changed" 
                                              Unchecked="StartupCheckBox_Changed"/>
                                </Border>
                                
                                <!-- 快捷键设置 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Content="快捷键设置" Margin="0,0,0,12"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBox x:Name="HotkeyTextBox" 
                                                     Width="250" 
                                                     KeyDown="HotkeyTextBox_KeyDown" 
                                                     Margin="0,0,12,0"
                                                     IsReadOnly="True"
                                                     Text="点击设置快捷键"/>
                                            <Button x:Name="SaveHotkeyButton" 
                                                    Content="保存" 
                                                    Style="{StaticResource ModernButton}"
                                                    Click="SaveHotkeyButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <!-- 提醒频率 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Content="提醒频率" Margin="0,0,0,12"/>
                                        <ComboBox x:Name="ReminderFrequencyComboBox" 
                                                  Width="250" 
                                                  SelectionChanged="ReminderFrequencyComboBox_SelectionChanged">
                                            <ComboBoxItem Content="每天一次"/>
                                            <ComboBoxItem Content="每小时"/>
                                            <ComboBoxItem Content="每半小时"/>
                                            <ComboBoxItem Content="每分钟"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                
                                <!-- 修改主密码 -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Button x:Name="ChangeMasterPasswordButton" 
                                            Content="🔒 修改主密码" 
                                            Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Stretch"
                                            Click="ChangeMasterPasswordButton_Click"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
