<Window x:Class="NewDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="NewDesk" Height="720" Width="1100" 
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <!-- System Tray Component -->
        <tb:TaskbarIcon x:Name="MyNotifyIcon" 
                        ToolTipText="NewDesk 桌面助手"
                        LeftClickCommand="{Binding ShowWindowCommand}"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu x:Name="TrayContextMenu">
                    <MenuItem Header="⚡ NewDesk" IsEnabled="False" FontWeight="Bold"/>
                    <MenuItem Header="打开 NewDesk" Click="ShowWindow_Click"/>
                    <Separator/>
                    <MenuItem Header="🔑 快速搜索密码" Click="TraySearchPassword_Click"/>
                    <MenuItem Header="🔔 新建提醒" Click="TrayAddReminder_Click"/>
                    <MenuItem Header="🖼 下一张壁纸" Click="TrayNextWallpaper_Click"/>
                    <Separator/>
                    <MenuItem Header="🔒 锁定密码库" Click="TrayLockVault_Click"/>
                    <MenuItem Header="⚙ 设置" Click="TraySettings_Click"/>
                    <Separator/>
                    <MenuItem Header="退出 NewDesk" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Left Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Right Content -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,0">
                <Grid Margin="16,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- App Brand Logo -->
                        <RowDefinition Height="*"/>    <!-- Main Navigation List -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- App Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="⚡" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NewDesk" Style="{StaticResource Header1TextStyle}" FontSize="20"/>
                            <TextBlock Text="桌面效率助手" Style="{StaticResource CaptionTextStyle}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav Item List -->
                    <StackPanel Grid.Row="1">
                        <!-- Home -->
                        <RadioButton x:Name="NavHomeRadio" Content="🏠  首页概览" Tag="Home" GroupName="NavGroup" IsChecked="True" Style="{StaticResource NavItemStyle}" Checked="NavRadio_Checked"/>

                        <!-- Password -->
                        <RadioButton x:Name="NavPasswordsRadio" Content="🔑  密码管理" Tag="Passwords" GroupName="NavGroup" Style="{StaticResource NavItemStyle}" Checked="NavRadio_Checked"/>

                        <!-- Reminder -->
                        <RadioButton x:Name="NavRemindersRadio" Content="🔔  提醒事项" Tag="Reminders" GroupName="NavGroup" Style="{StaticResource NavItemStyle}" Checked="NavRadio_Checked"/>

                        <!-- Wallpaper -->
                        <RadioButton x:Name="NavWallpaperRadio" Content="🖼  桌面壁纸" Tag="Wallpaper" GroupName="NavGroup" Style="{StaticResource NavItemStyle}" Checked="NavRadio_Checked"/>

                        <!-- Dynamic Info -->
                        <RadioButton x:Name="NavDynamicInfoRadio" Content="⚡  动态信息" Tag="DynamicInfo" GroupName="NavGroup" Style="{StaticResource NavItemStyle}" Checked="NavRadio_Checked"/>

                        <Separator Margin="0,16,0,16" Background="{DynamicResource BorderBrushColor}"/>

                        <!-- Settings -->
                        <RadioButton x:Name="NavSettingsRadio" Content="⚙  系统设置" Tag="Settings" GroupName="NavGroup" Style="{StaticResource NavItemStyle}" Checked="NavRadio_Checked"/>

                        <!-- Help -->
                        <RadioButton x:Name="NavHelpRadio" Content="?  帮助与关于" Tag="Help" GroupName="NavGroup" Style="{StaticResource NavItemStyle}" Checked="NavRadio_Checked"/>
                    </StackPanel>

                    <!-- Bottom Vault Lock Indicator Status -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="8" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SidebarLockIconText" Text="🔓" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SidebarLockStatusText" Text="密码库已解锁" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT MAIN CONTENT CONTAINER -->
            <Grid Grid.Column="1">
                <ContentControl x:Name="MainContentControl"/>
            </Grid>
        </Grid>
    </Grid>

    <!-- Sidebar Navigation RadioButton Style -->
    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarItemSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
