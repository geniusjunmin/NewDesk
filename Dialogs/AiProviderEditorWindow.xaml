<Window x:Class="NewDesk.Dialogs.AiProviderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置 AI 模型服务" Height="580" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Form Content -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙ 配置 AI 服务提供商" Style="{StaticResource Header1TextStyle}"/>
            <TextBlock Text="配置云端 AI API 密钥或本地 LLM 模型连接参数" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="服务类型 (Provider Kind)：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="KindComboBox" Margin="0,0,0,12" SelectionChanged="KindComboBox_SelectionChanged">
                            <ComboBoxItem Content="OpenAI"/>
                            <ComboBoxItem Content="Google Gemini"/>
                            <ComboBoxItem Content="xAI (Grok)"/>
                            <ComboBoxItem Content="MiniMax"/>
                            <ComboBoxItem Content="Anthropic Claude"/>
                            <ComboBoxItem Content="DeepSeek"/>
                            <ComboBoxItem Content="Ollama (Local)"/>
                            <ComboBoxItem Content="LM Studio (Local)"/>
                            <ComboBoxItem Content="Custom OpenAI Compatible"/>
                        </ComboBox>

                        <TextBlock Text="服务显示名称：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameTextBox" Text="OpenAI" Margin="0,0,0,12"/>

                        <TextBlock Text="Base API URL：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <TextBox x:Name="BaseUrlTextBox" Text="https://api.openai.com/v1" Margin="0,0,0,12"/>

                        <TextBlock Text="API Key (Windows DPAPI 加密保护)：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyPasswordBox" Margin="0,0,8,0"/>
                            <TextBox x:Name="ApiKeyTextBox" Visibility="Collapsed" Margin="0,0,8,0"/>
                            <ToggleButton x:Name="ShowKeyToggle" Grid.Column="1" Content="👁 显示" Padding="8,4" Click="ShowKeyToggle_Click"/>
                        </Grid>

                        <TextBlock Text="模型 (Model ID)：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModelComboBox" IsEditable="True" Margin="0,0,8,0"/>
                            <Button x:Name="FetchModelsButton" Grid.Column="1" Content="⟳ 自动获取模型" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="FetchModelsButton_Click"/>
                        </Grid>

                        <CheckBox x:Name="StreamingCheckBox" Content="启用流式输出 (Streaming)" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,12"/>

                        <CheckBox x:Name="DefaultCheckBox" Content="设为默认 AI 服务" Style="{StaticResource ToggleSwitchStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Test Connection Status Panel -->
                <Border x:Name="TestResultBorder" Style="{StaticResource CardStyle}" Padding="12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TestResultTitle" Text="✓ 连接成功" Style="{StaticResource Header2TextStyle}" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock x:Name="TestResultDetail" Text="延迟: 320 ms | 包含 12 个可用模型" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="TestConnectionButton" Content="⚡ 测试连接" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Width="110" Click="TestConnectionButton_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="SaveButton" Content="确定保存" Style="{StaticResource ModernButton}" Width="110" IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
