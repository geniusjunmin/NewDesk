<Window x:Class="NewDesk.Dialogs.ApiDataWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置 API 动态数据" Height="580" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔗 API 动态数据提取向导" Style="{StaticResource Header1TextStyle}"/>
            <TextBlock Text="轻松从网络 API 接口提取温度、汇率或自定义数据并展示在桌面上" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Step 1: Data Source -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Step 1: 设置 API 数据接口地址" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ApiUrlTextBox" Text="https://wttr.in/Beijing?format=j1" Margin="0,0,8,0"/>
                            <Button x:Name="TestConnectButton" Grid.Column="1" Content="测试连接" Style="{StaticResource ModernButton}" Width="100" Click="TestConnectButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="StatusText" Text="提示：输入 API 接口地址后点击“测试连接”" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Step 2: JSON Field Selector Tree -->
                <Border x:Name="Step2Border" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Step 2: 选择需要提取的数据字段" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,8"/>
                        <TreeView x:Name="JsonTreeView" Height="160" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" SelectedItemChanged="JsonTreeView_SelectedItemChanged"/>
                    </StackPanel>
                </Border>

                <!-- Step 3: Prefix & Suffix Formatting -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Step 3: 设置显示样式与前后缀" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="前缀 (Prefix)：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PrefixTextBox" Text="温度：" TextChanged="FormatPreview_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="后缀 (Suffix)：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SuffixTextBox" Text="°C" TextChanged="FormatPreview_Changed"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="实时效果预览：" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PreviewText" Text="温度：18°C" Style="{StaticResource Header2TextStyle}" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Advanced Configuration Expander -->
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,16">
                    <Expander Header="⚙ 高级 API 设置 (Regex &amp; Header)" IsExpanded="False">
                        <StackPanel Margin="4,12,4,4">
                            <TextBlock Text="正则表达式 (Regex Extraction Rule)：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="RegexTextBox" Text="&quot;temp_C&quot;:\s*&quot;(\d+)&quot;" Margin="0,0,0,8"/>

                            <TextBlock Text="格式化规则 (Formatting)：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="FormattingTextBox" Text="{}{0}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="确定保存" Style="{StaticResource ModernButton}" Width="110" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
