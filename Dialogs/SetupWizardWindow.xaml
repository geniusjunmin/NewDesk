<Window x:Class="NewDesk.Dialogs.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NewDesk 设置向导" Height="620" Width="820"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Step Indicator Header -->
            <RowDefinition Height="*"/>    <!-- Step Content Area -->
            <RowDefinition Height="Auto"/> <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- Header / Step Indicator -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ NewDesk" Style="{StaticResource Header2TextStyle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="StepTitleText" Text="第 1 步：欢迎" Style="{StaticResource Header2TextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StepIndicatorText" Text="1 / 5" Style="{StaticResource CaptionTextStyle}" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Step Content Container -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,16">
            <Grid x:Name="StepContainer">

                <!-- STEP 1: Welcome -->
                <Grid x:Name="Step1Grid" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="欢迎使用 NewDesk" Style="{StaticResource Header1TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="NewDesk 可以帮你管理密码、提醒事项、桌面壁纸以及常用动态信息。" Style="{StaticResource SubHeaderTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                        <UniformGrid Columns="2" Rows="2" Margin="10,0">
                            <!-- Card 1 -->
                            <Border Style="{StaticResource CardStyle}" Margin="8" Background="{DynamicResource SurfaceSecondaryBackground}">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="🔑" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="密码管理" Style="{StaticResource Header2TextStyle}"/>
                                        <TextBlock Text="安全保存常用账号与密码" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 2 -->
                            <Border Style="{StaticResource CardStyle}" Margin="8" Background="{DynamicResource SurfaceSecondaryBackground}">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="🔔" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="提醒事项" Style="{StaticResource Header2TextStyle}"/>
                                        <TextBlock Text="重要日期与日程不再忘记" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 3 -->
                            <Border Style="{StaticResource CardStyle}" Margin="8" Background="{DynamicResource SurfaceSecondaryBackground}">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="🖼" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="桌面壁纸" Style="{StaticResource Header2TextStyle}"/>
                                        <TextBlock Text="管理并自动轮播高清壁纸" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 4 -->
                            <Border Style="{StaticResource CardStyle}" Margin="8" Background="{DynamicResource SurfaceSecondaryBackground}">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="⚡" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="动态信息" Style="{StaticResource Header2TextStyle}"/>
                                        <TextBlock Text="把天气、API 数据等显示在桌面" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!-- STEP 2: Security / Master Password -->
                <Grid x:Name="Step2Grid" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="保护你的数据" Style="{StaticResource Header1TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="主密码用于加密你的密码库，仅保存在本地设备，不会上传到任何服务器。" Style="{StaticResource SubHeaderTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

                        <StackPanel x:Name="MasterPasswordSetupPanel">
                            <TextBlock Text="主密码：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <PasswordBox x:Name="WizardMasterPasswordBox" PasswordChanged="WizardMasterPasswordBox_PasswordChanged"/>
                                <TextBox x:Name="WizardMasterPasswordTextBox" Visibility="Collapsed" TextChanged="WizardMasterPasswordTextBox_TextChanged"/>
                            </Grid>

                            <TextBlock Text="确认主密码：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <PasswordBox x:Name="WizardConfirmPasswordBox" PasswordChanged="WizardConfirmPasswordBox_PasswordChanged"/>
                                <TextBox x:Name="WizardConfirmPasswordTextBox" Visibility="Collapsed" TextChanged="WizardConfirmPasswordTextBox_TextChanged"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox x:Name="ShowPasswordCheckBox" Content="显示密码" Style="{StaticResource ToggleSwitchStyle}" Checked="ShowPasswordCheckBox_Changed" Unchecked="ShowPasswordCheckBox_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                <TextBlock Text="密码强度：" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="PasswordStrengthProgress" Width="140" Height="8" Margin="8,0,12,0" Minimum="0" Maximum="100"/>
                                <TextBlock x:Name="PasswordStrengthText" Text="未输入" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                            </StackPanel>

                            <Border Background="{DynamicResource SurfaceSecondaryBackground}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBlock Text="⚠️ 注意：主密码丢后将无法解密密码库，请务必妥善保存。" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="Step2ErrorText" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: Usage / Startup & Hotkey -->
                <Grid x:Name="Step3Grid" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" MaxWidth="540">
                        <TextBlock Text="使用偏好" Style="{StaticResource Header1TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="设置 NewDesk 的启动方式与快捷键" Style="{StaticResource SubHeaderTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartCheckBox" Content="Windows 启动时自动运行 NewDesk (推荐)" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,16"/>
                                <CheckBox x:Name="StartMinimizedCheckBox" Content="启动后自动最小化到系统托盘" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,8"/>
                                <TextBlock Text="开启后应用将在后台静默运行，可通过托盘图标随时调出。" Style="{StaticResource CaptionTextStyle}" Margin="52,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="显示 / 隐藏主窗口全局快捷键" Style="{StaticResource Header2TextStyle}"/>
                                    <TextBlock Text="在任何界面按下快捷键均可快速调出 NewDesk" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceSecondaryBackground}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + Alt + D" FontWeight="Bold" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 4: Features Selection -->
                <Grid x:Name="Step4Grid" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" MaxWidth="540">
                        <TextBlock Text="选择开启的功能" Style="{StaticResource Header1TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="开启你准备使用的模块，稍后可在设置中随时调整。" Style="{StaticResource SubHeaderTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,8">
                                <CheckBox x:Name="EnablePasswordsCheckBox" Content="🔑 密码管理 (安全加密存储账号)" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,8">
                                <CheckBox x:Name="EnableRemindersCheckBox" Content="🔔 提醒事项 (重要日程提醒)" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,8">
                                <CheckBox x:Name="EnableWallpaperCheckBox" Content="🖼 桌面壁纸 (自动轮播高清壁纸)" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,8">
                                <CheckBox x:Name="EnableDynamicInfoCheckBox" Content="⚡ API 动态信息 (高级功能，桌面显示实时天气与数据)" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- STEP 5: Finish -->
                <Grid x:Name="Step5Grid" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" MaxWidth="540">
                        <TextBlock Text="🎉 一切准备就绪！" Style="{StaticResource Header1TextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="配置已保存，开始体验 NewDesk 带来的便利吧。" Style="{StaticResource SubHeaderTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <Border Style="{StaticResource CardStyle}" Padding="20" Background="{DynamicResource SurfaceSecondaryBackground}">
                            <StackPanel>
                                <TextBlock Text="配置摘要" Style="{StaticResource Header2TextStyle}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="SummaryMasterPasswordText" Text="✓ 主密码已保护" Style="{StaticResource BodyTextStyle}" Margin="0,4"/>
                                <TextBlock x:Name="SummaryStartupText" Text="✓ Windows 开机启动已设置" Style="{StaticResource BodyTextStyle}" Margin="0,4"/>
                                <TextBlock x:Name="SummaryHotkeyText" Text="✓ 全局快捷键 Ctrl + Alt + D 已启用" Style="{StaticResource BodyTextStyle}" Margin="0,4"/>
                                <TextBlock x:Name="SummaryFeaturesText" Text="✓ 已启用选定功能模块" Style="{StaticResource BodyTextStyle}" Margin="0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2">
            <Button x:Name="BackButton" Content="返回" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Width="100" Click="BackButton_Click" Visibility="Collapsed"/>
            <Button x:Name="NextButton" Content="下一步" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Width="120" Click="NextButton_Click"/>
        </Grid>
    </Grid>
</Window>
