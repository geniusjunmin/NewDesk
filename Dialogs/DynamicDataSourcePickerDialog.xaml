<Window x:Class="NewDesk.Dialogs.DynamicDataSourcePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择动态数据源" SizeToContent="Height" Width="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="选择动态数据源" Style="{StaticResource Header1TextStyle}" Grid.Row="0" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="选择要与当前文本图层绑定的动态数据源：" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,10"/>
            <ListBox x:Name="DataSourcesListBox" Height="200" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Margin="0,0,0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Header2TextStyle}"/>
                                <TextBlock Text="{Binding Url}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="90" IsCancel="True" Margin="0,0,12,0"/>
            <Button Content="确定绑定" Style="{StaticResource ModernButton}" Width="110" IsDefault="True" Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
