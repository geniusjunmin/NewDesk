<Window x:Class="NewDesk.Dialogs.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制快捷键" Height="260" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#18181B" Foreground="#F4F4F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="⌨️ 请按下组合快捷键" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5" Margin="0,0,0,4"/>
            <TextBlock Text="请在键盘上直接按下包含 Ctrl/Alt/Shift 的快捷键组合..." FontSize="12" Foreground="#A1A1AA"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#27272A" CornerRadius="8" Margin="0,16" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBlock x:Name="TxtCapturedHotkey" Text="等待按键输入..." FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Height="34" Margin="0,0,12,0" Background="#3F3F46" Foreground="#F4F4F5" BorderThickness="0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnConfirm" Content="确定保存" Width="90" Height="34" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" IsEnabled="False" Click="BtnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
