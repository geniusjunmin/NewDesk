<Window x:Class="NewDesk.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作" Height="220" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="提示标题" Style="{StaticResource Header2TextStyle}" Grid.Row="0"/>
        <TextBlock x:Name="MessageText" Text="提示详细说明信息" Style="{StaticResource BodyTextStyle}" Grid.Row="1" TextWrapping="Wrap" Margin="0,12,0,12" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="ConfirmButton" Content="确认" Style="{StaticResource DangerButton}" Width="90" Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
